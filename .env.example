# Public configuration is included in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical origin used by metadata and sitemap generation.
APP_URL=http://localhost:3000
APP_ENV=development

# Optional privileged integration credential. Ordinary application requests use
# the authenticated user's session and RLS, rather than this credential.
SUPABASE_SECRET_KEY=

# Optional database connection for migration tooling. Server application queries
# use Supabase's Data API. Power BI credentials are configured in Power BI Service.
DATABASE_URL=

# Power BI integration is optional for local development and the portfolio demo.
POWER_BI_ENABLED=false
POWER_BI_TENANT_ID=
POWER_BI_CLIENT_ID=
POWER_BI_CLIENT_SECRET=
POWER_BI_WORKSPACE_ID=
POWER_BI_REPORT_ID=
POWER_BI_DATASET_ID=

# Optional authentication for a scheduled report-job dispatcher.
CRON_SECRET=
